# ══════════════════════════════════════════════════════════════════════════════
# Lab 02 — Foundry Complete
# Copia como .env y llena con tus valores reales
# ══════════════════════════════════════════════════════════════════════════════

# ── Azure AI Foundry — Proyecto ───────────────────────────────────────────────
# Encuéntralo en: ai.azure.com → tu proyecto → Overview → Endpoints
# Formato: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# API key del proyecto (aparece junto al endpoint en ai.azure.com)
AZURE_AI_AGENTS_KEY=your_api_key_here

# Deployment del modelo a usar (ej: gpt-4o, DeepSeek-V3-0324, Phi-3.5-mini)
FOUNDRY_MODEL=DeepSeek-V3-0324

# ── Azure OpenAI (para evaluaciones — usa un modelo judge) ───────────────────
# Las evaluaciones de Foundry necesitan un modelo separado para juzgar las respuestas
# Puede ser el mismo que FOUNDRY_PROJECT_ENDPOINT si usas Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-account.openai.azure.com/
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # Modelo para actuar como "judge" en evaluaciones
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Bing Search (para step3 — Bing Grounding tool, opcional) ─────────────────
# Encuéntralo en: Azure Portal → Bing Search resource → Keys
# Si no tienes, el lab usa function tools como alternativa
BING_API_KEY=your_bing_key_here

# ── Hashed SDK (para step8) ───────────────────────────────────────────────────
HASHED_BACKEND_URL=https://iamandagent-production.up.railway.app
HASHED_API_KEY=hashed_your_api_key_here
HASHED_IDENTITY_PASSWORD=your_password_here
