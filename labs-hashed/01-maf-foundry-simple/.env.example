# ══════════════════════════════════════════════════════════════════════════════
# Lab 01 — MAF + Foundry + Hashed
# Copia este archivo como .env y llena los valores reales
# ══════════════════════════════════════════════════════════════════════════════

# ── Azure AI Foundry ──────────────────────────────────────────────────────────
# Encuentra en: ai.azure.com → tu proyecto → Overview → Endpoints
# Formato: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=https://your-account.services.ai.azure.com/api/projects/your-project

# La API key del proyecto (misma que Azure AI Agents Key)
AZURE_AI_AGENTS_KEY=your_azure_ai_agents_key_here

# Nombre del deployment del modelo (ej. gpt-4o, DeepSeek-V3-0324)
FOUNDRY_MODEL=DeepSeek-V3-0324

# ── Hashed SDK (solo step 4) ──────────────────────────────────────────────────
HASHED_BACKEND_URL=https://iamandagent-production.up.railway.app
HASHED_API_KEY=hashed_your_api_key_here
HASHED_IDENTITY_PASSWORD=your_password_here
